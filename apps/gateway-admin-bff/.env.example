# WSO2 API Manager base (gateway/admin). No trailing slash.
APIM_BASE_URL=https://wso2am.example.internal:9443
# Browser-facing WSO2 URL for the OAuth login redirect (the user's browser cannot use a
# localhost/internal host). Defaults to APIM_BASE_URL. Server-side calls always use APIM_BASE_URL.
APIM_PUBLIC_URL=https://wso2.example.com:30443
# PEM file trusted as the CA for WSO2's self-signed cert. Never disable TLS verification.
APIM_CA_CERT_PATH=/etc/traceit/wso2-ca.pem
# Admin credentials used ONLY for first-start Dynamic Client Registration.
APIM_DCR_USERNAME=admin
APIM_DCR_PASSWORD=change-me
# Session cookie signing secret (>=32 chars).
SESSION_SECRET=replace-with-a-long-random-secret-string
# Public origin of this app, used as the OAuth redirect base.
PUBLIC_BASE_URL=http://localhost:8787
# Optional: migration-tool backend for the Migrated APIs screen.
MIGRATION_TOOL_URL=
PORT=8787
# Shared session store. Empty = in-memory (local dev only). Cluster: redis://intg-redis.wso2.svc:6379
REDIS_URL=
