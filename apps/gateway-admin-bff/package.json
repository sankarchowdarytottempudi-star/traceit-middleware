{
  "name": "gateway-admin-bff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "gen:types": "openapi-typescript openapi/admin-api.yaml -o src/wso2-admin.d.ts || true"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.1",
    "@fastify/static": "8.0.3",
    "fastify": "5.1.0",
    "fastify-plugin": "5.0.1",
    "pino": "9.5.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "openapi-typescript": "7.4.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5",
    "nock": "13.5.6"
  }
}