{
  "name": "gateway-admin-bff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "gen:types": "openapi-typescript openapi/admin-api.yaml -o src/wso2-admin.ts && openapi-typescript openapi/governance-api.yaml -o src/wso2-governance.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.1",
    "@fastify/static": "10.1.11",
    "fastify": "5.12.8",
    "fastify-plugin": "5.0.1",
    "pino": "9.5.0",
    "zod": "4.6.7",
    "redis": "4.7.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "openapi-typescript": "7.4.3",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "4.1.12",
    "nock": "13.5.6"
  }
}