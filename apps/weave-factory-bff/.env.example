# WSO2 SSO (same as the gateway app) - server-side base (internal host, cert CN matches).
APIM_BASE_URL=https://wso2am.example.internal:9443
# Browser-facing WSO2 URL for the OAuth redirect. Defaults to APIM_BASE_URL.
APIM_PUBLIC_URL=https://wso2.example.com:30443
APIM_CA_CERT_PATH=/etc/weave/wso2-ca.pem
APIM_DCR_USERNAME=admin
APIM_DCR_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-secret-string
PUBLIC_BASE_URL=http://localhost:8788
# Existing migration-tool control-plane backend (the migration engine already exists).
MT_BASE_URL=http://localhost:30900
MT_ADMIN_TOKEN=the-migration-tool-admin-token
# Shared session store. Empty = in-memory (local dev only). Cluster: redis://intg-redis.wso2.svc:6379
REDIS_URL=
# Writable dir for first-start DCR client creds (configurable - deploy lesson).
DATA_DIR=.data
PORT=8788
