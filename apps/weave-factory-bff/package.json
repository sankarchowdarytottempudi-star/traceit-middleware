    "pino": "9.5.0",
    "redis": "4.7.0",
    "zod": "4.6.7",
    "@traceit/weave-flow": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "nock": "13.5.6",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "4.1.12"
  }
