FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /app
COPY pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/weave-factory/package.json ./apps/weave-factory/package.json
COPY apps/weave-factory-bff/package.json ./apps/weave-factory-bff/package.json
RUN pnpm install --frozen-lockfile=false
COPY . .
RUN pnpm --filter weave-factory build && pnpm --filter weave-factory-bff build
RUN pnpm --filter weave-factory-bff deploy --prod /prod-bff
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /prod-bff/node_modules ./apps/weave-factory-bff/node_modules
COPY --from=build /app/apps/weave-factory-bff/dist ./apps/weave-factory-bff/dist
COPY --from=build /app/apps/weave-factory/dist ./apps/weave-factory/dist
ENV SPA_DIR=/app/apps/weave-factory/dist
USER node
EXPOSE 8788
WORKDIR /app/apps/weave-factory-bff
CMD ["node","dist/index.js"]
