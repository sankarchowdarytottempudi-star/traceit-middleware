FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /app
COPY pnpm-workspace.yaml package.json tsconfig.base.json pnpm-lock.yaml ./
COPY packages ./packages
COPY apps/weave-factory/package.json ./apps/weave-factory/package.json
COPY apps/weave-factory-bff/package.json ./apps/weave-factory-bff/package.json
RUN pnpm install --frozen-lockfile
COPY . .
ARG VITE_WEAVE_GATEWAY_URL=""
ENV VITE_WEAVE_GATEWAY_URL=$VITE_WEAVE_GATEWAY_URL
# product edition: "traceit" (default) or "cruise-saudi"
ARG VITE_WEAVE_EDITION="traceit"
ENV VITE_WEAVE_EDITION=$VITE_WEAVE_EDITION
RUN pnpm --filter @traceit/weave-flow build && pnpm --filter weave-factory build && pnpm --filter weave-factory-bff build
RUN pnpm --filter weave-factory-bff deploy --prod /prod-bff
# no test files in the image (dependencies' own tests are dropped too)
RUN find /prod-bff/node_modules -type f -name '*.test.*' -delete
# cruise-saudi: no TraceIT/Tottempudi name in any shipped file (fails the build otherwise); traceit: no-op
RUN node deploy/edition-dist.mjs "$VITE_WEAVE_EDITION" apps/weave-factory-bff --node-modules /prod-bff/node_modules --scan apps/weave-factory/dist
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
# the server enforces the same edition as the screens (cruise-saudi: MuleSoft (Mule 4) to WSO2 only);
# WEAVE_EDITION can still be set when the container is started
ARG VITE_WEAVE_EDITION="traceit"
ENV WEAVE_EDITION=$VITE_WEAVE_EDITION
COPY --from=build /prod-bff/node_modules ./apps/weave-factory-bff/node_modules
COPY --from=build /app/apps/weave-factory-bff/dist ./apps/weave-factory-bff/dist
COPY --from=build /app/apps/weave-factory/dist ./apps/weave-factory/dist
ENV SPA_DIR=/app/apps/weave-factory/dist
USER node
EXPOSE 8788
WORKDIR /app/apps/weave-factory-bff
CMD ["node","dist/index.js"]
