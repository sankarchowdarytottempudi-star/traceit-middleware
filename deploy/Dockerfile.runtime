# weave-runtime: stores, executes and publishes the flows designed in Weave Studio.
# Build from the repository root:  docker build -f deploy/Dockerfile.runtime -t weave-runtime:next .
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /app
COPY pnpm-workspace.yaml package.json tsconfig.base.json pnpm-lock.yaml ./
COPY packages/weave-flow ./packages/weave-flow
COPY apps/weave-runtime/package.json ./apps/weave-runtime/package.json
RUN pnpm install --frozen-lockfile --filter weave-runtime...
COPY apps/weave-runtime ./apps/weave-runtime
RUN pnpm --filter @traceit/weave-flow build && pnpm --filter weave-runtime build
RUN pnpm --filter weave-runtime deploy --prod /prod-runtime

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app/apps/weave-runtime
COPY --from=build /prod-runtime/node_modules ./node_modules
COPY --from=build /prod-runtime/package.json ./package.json
COPY --from=build /app/apps/weave-runtime/dist ./dist
RUN mkdir -p /data && chown 1000:1000 /data
# uid 1000 (the "node" user): the data directory on the host is owned by the same uid.
USER 1000:1000
EXPOSE 8790
CMD ["node","dist/index.js"]
