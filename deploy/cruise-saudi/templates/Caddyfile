# Cruise Saudi Weave reverse proxy. Rendered by install.sh from templates/Caddyfile - edit
# weave.conf and re-run install.sh instead of editing this file.
# Certificates are the files Cruise Saudi provided (no ACME). HTTP on @@HTTP_PORT@@ redirects to HTTPS.
{
	admin off
	auto_https disable_certs
	http_port @@HTTP_PORT@@
	https_port @@HTTPS_PORT@@
	storage file_system @@DATA@@/caddy
	log {
		output file @@DATA_ROOT@@/logs/caddy/caddy.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
}

# Security headers for both sites (set when the response is written, replacing what an upstream sent)
(security_headers) {
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-X-Powered-By
	}
}

@@WEAVE_DOMAIN@@@@HTTPS_SUFFIX@@ {
@@CADDY_BIND_LINE@@
	tls @@ETC@@/tls/weave.crt @@ETC@@/tls/weave.key
	encode gzip
	import security_headers
	# Weave consoles: never framed; scripts only from this origin plus the consoles' own inline
	# scripts (hashes taken from the installed images at install time)
	header {
		defer
		X-Frame-Options "DENY"
		Content-Security-Policy "@@WEAVE_CSP@@"
	}
	log {
		output file @@DATA_ROOT@@/logs/caddy/weave-access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
	# Weave Factory
	@factory path /factory /factory/*
	handle @factory {
		reverse_proxy 127.0.0.1:@@PORT_FACTORY@@
	}
@@GW_BLOCK@@
	# Weave Gateway console
	handle {
		reverse_proxy 127.0.0.1:@@PORT_GATEWAY@@
	}
}

@@APIM_DOMAIN@@@@HTTPS_SUFFIX@@ {
@@CADDY_BIND_LINE@@
	tls @@ETC@@/tls/apim.crt @@ETC@@/tls/apim.key
	encode gzip
	import security_headers
	# API Manager portals frame their own pages (OIDC session check), so framing is limited to the
	# same origin; API Manager sends X-Frame-Options itself on most pages (kept when present). Its
	# portals rely on inline scripts, so the policy here does not restrict script sources.
	header {
		defer
		?X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
	}
	log {
		output file @@DATA_ROOT@@/logs/caddy/apim-access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
	# API Manager portals (Publisher, DevPortal, Admin, Carbon) on port 9443 of the APIM pod
	reverse_proxy https://127.0.0.1:@@APIM_MGMT_NODEPORT@@ {
		transport http {
			tls_server_name localhost
			tls_trust_pool file @@ETC@@/apim-ca.pem
		}
	}
}
