# =====================================================================================
#  Cruise Saudi Weave - installation settings
#
#  The ONLY file an operator edits. Copy it, fill it in, then run:
#      cp weave.conf.example weave.conf && vi weave.conf
#      sudo ./install.sh --config weave.conf
#  install.sh keeps a copy at <DATA_ROOT>/etc/weave.conf; upgrade/backup/restore read that copy.
#  To change a setting later: edit <DATA_ROOT>/etc/weave.conf and run install.sh again
#  (it is safe to re-run; nothing is reset).
#
#  Shell syntax: NAME=value, no spaces around "=", quote values that contain spaces.
#  NO SECRETS HERE. Database passwords, session secrets, internal keys and the API Manager
#  administrator password are generated at install into <DATA_ROOT>/etc/secrets.env
#  (root only, mode 600).
# =====================================================================================

# ---- Names: INTERNAL DNS A records pointing to this server's PRIVATE IP ---------------
# (the server has no public IP and no internet; see NETWORK.md)
WEAVE_DOMAIN=weave.aroya.com          # Weave Gateway console at /, Weave Factory at /factory
APIM_DOMAIN=apim.aroya.com            # API Manager portals (Publisher, DevPortal, Admin, Carbon)

# ---- TLS certificate (provided by Cruise Saudi; no ACME / Let's Encrypt) ---------------
# PEM files. The certificate file holds the server certificate first, then the intermediate
# chain. It must cover BOTH names above (SAN list or a wildcard *.aroya.com).
# The key must be unencrypted (no passphrase). Files are copied to <DATA_ROOT>/etc/tls.
TLS_CERT_FILE=/root/certs/aroya.com.fullchain.pem
TLS_KEY_FILE=/root/certs/aroya.com.key
# Internal CA (PEM, intermediate(s) + root) that issued the certificate. Used to: verify the
# certificate at pre-flight, complete the served chain when the certificate file holds only the
# server certificate, and make the Weave services, the migration tool and this host trust internal
# HTTPS endpoints (registry, deployment cluster, IdP) signed by it. Empty for a public CA.
TLS_CA_FILE=/root/certs/aroya-internal-ca-chain.pem
# Optional: separate certificate for APIM_DOMAIN (leave empty to use the one above)
APIM_TLS_CERT_FILE=
APIM_TLS_KEY_FILE=

# ---- Contact ----------------------------------------------------------------------------
ADMIN_EMAIL=integration-admin@aroya.com   # shown in the RUNBOOK output / API Manager notifications

# ---- Where everything lives -------------------------------------------------------------
DATA_ROOT=/opt/weave                  # config, data, logs, backups (default /opt/weave)

# ---- Sizes (16 vCPU / 64 GB server) -----------------------------------------------------
APIM_CPU_LIMIT=4                      # API Manager pod CPU limit (cores)
APIM_MEMORY_LIMIT=8Gi                 # API Manager pod memory limit
APIM_JVM_HEAP=4g                      # API Manager JVM heap (-Xmx); keep about half the limit
APIM_STARTUP_MINUTES=5                # how long API Manager may take to boot before it is restarted
PG_CPU_LIMIT=2
PG_MEMORY_LIMIT=2Gi
APIM_DATA_SIZE=20Gi                   # API Manager volume (search index, keystores, local registry)
PG_DATA_SIZE=50Gi                     # PostgreSQL volume (all API Manager data)

# ---- Ports and exposure (NETWORK.md) ---------------------------------------------------
# No NodePorts: every port below is a host port bound to 127.0.0.1, except the API gateway port when
# LB_SOURCE_CIDRS is set.
# Load balancer address(es) that call the API gateway port DIRECTLY (IPv4 addresses or CIDRs, comma
# separated). Empty = the gateway port stays on 127.0.0.1 and consumers use https://WEAVE_DOMAIN/gw.
# Set = GATEWAY_HTTPS_NODEPORT listens on every address and a firewall chain installed by install.sh
# admits it only from these addresses (plus loopback and the pod network).
LB_SOURCE_CIDRS=
GATEWAY_HTTPS_NODEPORT=30243
GATEWAY_HTTP_NODEPORT=30280
GATEWAY_HTTP_EXPOSE=no                # yes = also expose plain-HTTP 30280 to LB_SOURCE_CIDRS
# Also publish the gateway under https://WEAVE_DOMAIN/gw/<context>/<version>/... (yes|no)
ENABLE_GW_PATH=yes
# Address API consumers use (shown in the consoles). Empty = https://WEAVE_DOMAIN/gw when
# ENABLE_GW_PATH=yes (or LB_SOURCE_CIDRS is empty), else https://WEAVE_DOMAIN:GATEWAY_HTTPS_NODEPORT.
# Put the load balancer URL here.
GATEWAY_PUBLIC_URL=
# Gateway rules (Gateway console): which stage this gateway is, and the request header that carries
# the REAL caller address for per-API IP allow/deny lists. Cruise Saudi's load balancer in front of the
# gateway MUST set/append X-Forwarded-For (the /gw path through this server's proxy does it already);
# without it every call appears to come from the load balancer.
GATEWAY_STAGE=production              # production | uat
GATEWAY_CLIENT_IP_HEADER=X-Forwarded-For
# Address(es) of the load balancer / reverse proxy that forwards users to port 443 of this server
# (comma separated IPv4 addresses or CIDRs). Its X-Forwarded-For is kept, so IP blocking and per-API
# IP rules see the real caller; from any other address the header is replaced by the connection
# address. Empty = callers connect to this server directly (loopback is always trusted).
TRUSTED_PROXY_CIDRS=
# Internal ports, 127.0.0.1 only (only change if they clash with something)
APIM_MGMT_NODEPORT=30443
MT_NODEPORT=30900

# ---- Deployment target for migrated APIs (optional; can be set later in the Factory) ----
# Migrated APIs run on a DIFFERENT Kubernetes cluster. Leave empty until it exists.
DEPLOY_TARGET_KUBECONFIG=             # path to a kubeconfig file on this server
DEPLOY_TARGET_CONTEXT=                # context in that kubeconfig (empty = current-context)
DEPLOY_TARGET_NAMESPACE=wso2          # namespace the APIs are deployed into
DEPLOY_TARGET_REGISTRY=               # e.g. registry.aroya.com/integration (images are pushed here)
DEPLOY_TARGET_REGISTRY_USER=
DEPLOY_TARGET_REGISTRY_PASSWORD_FILE= # file holding the registry password (not the password itself)

# ---- Sign-in ----------------------------------------------------------------------------
# Sign-in choices for the Weave consoles, in order (comma separated):
#   local = Weave accounts (e-mail + password kept on this server)  - keep it as the break-glass path
#   oidc  = Microsoft Entra ID (needs the OIDC_* values below; skipped with a warning while they are empty)
#   wso2  = API Manager users (TraceIT behaviour; not used at Cruise Saudi)
# Roles (Admin / Migration / Gateway) are managed in Gateway console -> Admin -> Users and access.
# Entra set-up for Cruise Saudi's administrator: docs/CRUISE-SAUDI-SSO.md
AUTH_PROVIDER=local,oidc
# First Weave admin (a Weave account). Its password is generated at install, kept in secrets.env
# (WEAVE_BOOTSTRAP_PASSWORD) and printed ONCE at the end of the first install.
WEAVE_ADMIN_EMAIL=integration-admin@aroya.com
WEAVE_ADMIN_NAME="Weave Admin"
OIDC_ISSUER=                          # https://login.microsoftonline.com/<tenant id>/v2.0
OIDC_CLIENT_ID=                       # application (client) ID of the "Cruise Saudi Weave" app registration
OIDC_CLIENT_SECRET_FILE=              # file holding the client secret VALUE (root-only), never the secret itself
OIDC_GROUPS_CLAIM=groups              # "roles" when Entra App roles are used instead of groups
OIDC_SCOPES="openid profile email"
OIDC_LABEL="Sign in with Microsoft"
OIDC_HTTPS_PROXY=                     # proxy for the Microsoft calls only, e.g. http://proxy.aroya.local:3128
AUTH_SESSION_HOURS=12
# API Manager administrator (portals at APIM_DOMAIN; also the service account Weave uses towards
# API Manager). Password generated at install (secrets.env: APIM_ADMIN_PASSWORD).
APIM_ADMIN_USER=admin

# ---- Backups ----------------------------------------------------------------------------
# A local directory or a mounted share (NFS/CIFS). Must exist or be creatable.
BACKUP_TARGET=/opt/weave/backups
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE="30 1 * * *"          # cron line for the nightly backup (empty = no schedule)

# ---- Offline ------------------------------------------------------------------------------
# The installer is fully offline: everything comes from the bundle; it never downloads and never
# calls apt/dnf (unless install.sh --use-os-repo is given, which uses the server's own INTERNAL
# repository). Outbound connections the running system may need are listed in NETWORK.md.
# If outbound HTTPS (e.g. Microsoft Entra sign-in) must go through a corporate proxy:
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,10.42.0.0/16,10.43.0.0/16,.svc,.cluster.local
