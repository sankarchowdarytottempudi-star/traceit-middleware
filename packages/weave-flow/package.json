{
  "name": "@traceit/weave-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared contract for Weave Studio: flow model, node catalog, runtime REST DTOs. Types and static data only.",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
